# This is a template for a .env file
# The .env file is used to load environmental variables
# Copy this file and delete {.template} part from {.env.template}

# https://openrouter.ai/
# OPENROUTER_API_KEY=

# https://huggingface.co/docs/hub/security-tokens
# HF_TOKEN=

# https://github.com/settings/tokens
# GITHUB_TOKEN=

# =============================================================================
# Meta-Agent Configuration
# =============================================================================

# Worker model for agent nodes
# DEFAULT_META_MODEL=anthropic/claude-sonnet-4

# Model that generates the judge pool (Meta Agent)
# META_AGENT_MODEL=google/gemini-2.5-flash

# Sampling temperature for the Meta Agent (default: 0.3)
# POOL_GEN_TEMPERATURE=0.3

# =============================================================================
# Agent Node Configuration
# =============================================================================

# Worker model for agent nodes
# AGENT_NODE_MODEL=google/gemini-2.5-flash

# Temperature for agent nodes (default: 0)
# AGENT_NODE_TEMPERATURE=0

# OpenAI-compatible API endpoint (default: OpenRouter)
# ENDPOINT_API_URL=https://openrouter.ai/api/v1

# =============================================================================
# API-Keys for MCP-Servers
# =============================================================================

# https://github.com/e2b-dev/e2b?tab=readme-ov-file#2-get-your-e2b-api-key
# E2B_API_KEY=

# =============================================================================
# LLM Models for MCP-Servers
# =============================================================================

# Audio Server
# AUDIO_MODEL=google/gemini-2.5-flash

# Image Server
# IMAGE_MODEL=google/gemini-2.5-flash

# Video Server
# VIDEO_MODEL=google/gemini-2.5-flash

# Browser Server
# BROWSERUSE_MODEL=google/gemini-2.5-flash

# =============================================================================
# MASEval Judge Model
# =============================================================================

# MASEVAL_DEFAULT_MODEL=google/gemini-2.5-flash

# =============================================================================
# LLM Tracing
# =============================================================================

# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
